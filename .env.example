# CrMcDownload 镜像服务运行配置模板：复制为 .env 后按需修改。
# 说明：应用只读 os.environ，不解析本文件；由部署层把这里的环境变量注入进程
#（systemd 的 EnvironmentFile，或 run.sh 里的 `set -a; . ./.env; set +a`）。
# 留空/缺省 = 用代码默认值。

MIRROR_LISTEN=127.0.0.1:8081
MIRROR_CACHE_DIR=/var/lib/offcraft-mirror
MIRROR_TOKEN=change-me-to-a-random-token
MIRROR_METADATA_TTL=600
UV_CACHE_DIR=/var/lib/offcraft-mirror/uv-cache

# 持久数据根目录：数据库 / 皮肤 / 官方插件包 / 热门种子都在这里，不存在会自动创建。
# 相对路径按进程工作目录解析（默认与 server/ 同级的 db/CrMcDownload）。
MIRROR_DATA_DIR=../db/CrMcDownload
# 也可单独覆盖各子路径：
# MIRROR_DB_PATH=../db/CrMcDownload/mirror.db
# MIRROR_SKINS_DIR=../db/CrMcDownload/skins
# MIRROR_POPULAR_DATA=../db/CrMcDownload/popular_servers.json

# 上游（默认官方；如服务器无法直连可改）
# UPSTREAM_META=https://piston-meta.mojang.com
# UPSTREAM_DATA=https://piston-data.mojang.com
# UPSTREAM_LIBS=https://libraries.minecraft.net
# UPSTREAM_ASSETS=https://resources.download.minecraft.net
# UPSTREAM_FABRIC=https://meta.fabricmc.net
# UPSTREAM_FABRICMAVEN=https://maven.fabricmc.net
# UPSTREAM_FORGEMAVEN=https://maven.minecraftforge.net
# UPSTREAM_NEOFORGEMAVEN=https://maven.neoforged.net
# UPSTREAM_MODRINTH=https://api.modrinth.com
# UPSTREAM_MODCDN=https://cdn.modrinth.com
# GitHub Releases 资产（客户端安装包镜像下载，支持 Range 断点续传）
# UPSTREAM_GITHUB=https://github.com

# 上游代理（可选）
# UPSTREAM_PROXY=socks5h://127.0.0.1:1080

# --- 版本与更新：最新版本自动检测，不用再手改版本号 ---
# 发布仓库：服务端直接读 https://api.github.com/repos/<repo>/releases，
# 取「最新的非预发布版」作为对外通告的最新版本（含 tag、发布页、资产与更新日志）。
MIRROR_UPDATE_REPO=leaf-CatLin/CrMcDownload
# 自动检测开关：on = 定时/请求驱动地拉 GitHub Releases；off = 只用快照文件与兜底值
MIRROR_UPDATE_AUTO=on
# 快照新鲜期（秒）：过期后由第一个请求或后台线程回源刷新（带 ETag 条件请求）
MIRROR_UPDATE_CACHE_TTL=600
# 快照落盘位置（空 = <MIRROR_DATA_DIR>/releases.json），重启后立刻可用
# MIRROR_UPDATE_CACHE_FILE=../db/CrMcDownload/releases.json
# 访问 GitHub 的超时（秒）
# MIRROR_UPDATE_TIMEOUT=8
# 可选 GitHub Token：只提高 API 额度（60 → 5000 次/小时），公开仓库不需要
# MIRROR_UPDATE_GITHUB_TOKEN=ghp_xxx
# 是否把 GitHub 上的预发布版也当作最新版（默认不）
# MIRROR_UPDATE_INCLUDE_PRERELEASE=off
#
# 兜底版本号：仅当 GitHub 不可达且没有快照文件时使用（正常部署不用维护）
MIRROR_UPDATE_LATEST_VERSION=0.9.1
# 最低可用版本：客户端版本（X-OffCraft-Version）低于它时 API 与下载返回 426。
# 留空 = 不做版本门槛；auto = 自动取「当前次版本的上一档」（0.9.1 -> 0.8.0）；
# 也可以写死，如 0.8.5。
MIRROR_UPDATE_MIN_VERSION=
# off = 只提示不拒绝（版本过低仍返回正常数据）
MIRROR_UPDATE_ENFORCE=on
# 自定义发布页（空 = 按仓库 + tag 自动拼）
# MIRROR_UPDATE_RELEASE_URL=https://github.com/leaf-CatLin/CrMcDownload/releases/tag/v{version}
# 安装包文件名，支持 {version} 占位；空 = 按 GitHub 资产自动挑（setup / install 优先）
# MIRROR_UPDATE_ASSET=CrMCDownload-{version}-win64-setup.exe

# --- 官网 + 看板静态产物（/page/*）：默认 ./page/dist，随仓库提交 ---
# MIRROR_PAGE_DIR=./page/dist

# --- 离线联机（P2P）：不设这几项则 /p2p/* 返回 404「离线联机未启用」 ---
MIRROR_P2P_ENABLE=on
# 中继对外通告地址（空则回落监听地址，公网不可达）
MIRROR_P2P_RELAY_HOST=mc.yjlt.top
# 数据面裸 TCP 端口，需在云安全组/防火墙单独放行
MIRROR_P2P_RELAY_PORT=25577
# MIRROR_P2P_MAX_ROOMS=256
# MIRROR_P2P_MAX_ROOMS_PER_DEVICE=10
# MIRROR_P2P_ROOM_TTL=180
# MIRROR_P2P_RELAY_BYTES_CAP=536870912
# 虚拟局域网（Wintun + UDP 打洞/中继）：关掉后客户端自动回落旧 TCP 隧道
# MIRROR_P2P_VPN_ENABLE=on
# UDP 边缘端口（HELLO 登记 / 打洞协调 / R <sid> 中继），需在安全组放行 UDP
# MIRROR_P2P_UDP_PORT=25578
# MIRROR_P2P_UDP_BYTES_CAP=536870912
# 边缘令牌有效期（秒），长会话由信令轮询自动续签
# MIRROR_P2P_EDGE_TOKEN_TTL=180

# --- 官方特权插件按需下载：GET /plugin/* 从此目录读取 ---
MIRROR_PLUGIN_DIR=../db/CrMcDownload/plugins
